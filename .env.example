# 复制成 .env 再填。.env 已在 .gitignore 里，不会进仓库。
# 模型：任何 OpenAI 兼容的 chat completions 服务都可以。
FILM_AGENT_LLM_API_KEY=
FILM_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
FILM_AGENT_LLM_MODEL=deepseek-chat

# 搜索：auto 会优先用下面的 Key；没有 Key 时用 DuckDuckGo + 360 免费兜底。
# provider 可选 auto / tavily / brave / duckduckgo。
FILM_AGENT_SEARCH_PROVIDER=auto
FILM_AGENT_SEARCH_API_KEY=

# TMDB：免费申请，用来拿结构化评分、用户评论和合法观看渠道（免费优先）。
# https://www.themoviedb.org/settings/api
FILM_AGENT_TMDB_API_KEY=
FILM_AGENT_REGION=CN
